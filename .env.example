# Número completo com DDI e DDD, apenas dígitos. Ex.: 5575XXXXXXXXX
NEXT_PUBLIC_WHATSAPP_NUMBER=

# URL pública final usada no canonical, sitemap e Open Graph.
NEXT_PUBLIC_SITE_URL=

# Opcional. Ex.: G-XXXXXXXXXX
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# waitlist ou open
NEXT_PUBLIC_COHORT_STATUS=waitlist

# Necessários apenas quando NEXT_PUBLIC_COHORT_STATUS=open
NEXT_PUBLIC_COHORT_START_DATE=
NEXT_PUBLIC_COHORT_SCHEDULE=thursday
NEXT_PUBLIC_COHORT_AVAILABLE_SPOTS=

# Gestão: obrigatório na Vercel. PostgreSQL/Neon com TLS; nunca NEXT_PUBLIC_.
# Vazio em desenvolvimento usa SQLite local em .data/.
GFB_DATABASE_URL=
# Apenas desenvolvimento/testes; não configurar como armazenamento na Vercel.
GFB_AUTH_DATABASE_PATH=
